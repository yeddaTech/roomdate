# Copia questo file in .env.local (escluso da git) e compila i valori.
# Lo leggono sia Vite (solo le variabili VITE_*) sia gli strumenti Go in cmd/ (dev, migrate, seed).

# Database di SVILUPPO: un branch Neon dedicato o un Postgres locale. Mai quello di produzione.
# Con Neon usa la connessione diretta (host senza "-pooler") e sslmode=require.
DATABASE_URL=postgresql://utente:password@localhost:5432/roomdate?sslmode=disable

# Chiave per firmare le sessioni. In locale basta una stringa casuale: openssl rand -hex 32
JWT_SECRET=

# Test di integrazione (npm run test:api): connessione a un Postgres su cui l'utente può creare database.
# Ogni esecuzione crea e poi elimina un database temporaneo "roomdate_test_…": quello indicato qui non viene toccato.
# Senza questa variabile i test che usano il database vengono saltati.
# TEST_DATABASE_URL=postgresql://utente:password@localhost:5432/postgres?sslmode=disable

# Origini aggiuntive da cui accettare richieste che modificano dati (es. un dominio personalizzato),
# separate da virgola. Il dominio su cui gira il sito è sempre accettato.
# TRUSTED_ORIGINS=https://www.roomdate.it

# Pusher (facoltativo in locale). Senza, la chat funziona ma si aggiorna ogni 5 secondi.
# Usa un'app Pusher separata da quella di produzione: il canale degli eventi è condiviso.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=eu
